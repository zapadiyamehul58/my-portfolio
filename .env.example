# APP_URL: The URL where the portfolio is hosted
# Production: https://mehul-zapadiya.vercel.app
# Local development: http://localhost:8000
APP_URL=https://mehul-zapadiya.vercel.app

# ADMIN_EMAIL: Mehul's inbox where notifications and visitor replies are directed
ADMIN_EMAIL=zapadiyamehul58@gmail.com

# -------------------------------------------------------------
# PRIMARY EMAIL PROVIDER: Resend (https://resend.com)
# -------------------------------------------------------------
# 1. Sign up at https://resend.com and generate an API Key.
# 2. Free testing tier:
#    MAIL_FROM="Mehul Zapadiya <onboarding@resend.dev>"
#    Note: Resend's onboarding@resend.dev allows sending ONLY to your registered account email (zapadiyamehul58@gmail.com).
# 3. Production domain verification:
#    To send real emails to ANY visitor's inbox, verify your custom domain at https://resend.com/domains
#    Then set:
#    MAIL_FROM="Mehul Zapadiya <contact@yourdomain.com>"
RESEND_API_KEY=
MAIL_FROM="Mehul Zapadiya <onboarding@resend.dev>"

# -------------------------------------------------------------
# ALTERNATIVE / FALLBACK EMAIL PROVIDER: Gmail or SMTP
# -------------------------------------------------------------
# If you don't have a custom domain in Resend, you can use a Google App Password
# to send emails directly from your Gmail account to ANY visitor's email address:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate a 16-character App Password (e.g. "abcd efgh ijkl mnop").
# 4. Paste it below:
GMAIL_APP_PASSWORD=

# Optional: Custom SMTP (if using another provider like SendGrid, Brevo, Mailgun)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=zapadiyamehul58@gmail.com
# SMTP_PASS=

# JWT Secret for Admin Authentication
JWT_SECRET=mehul_zapadiya_portfolio_jwt_secret_2026_super_secure

# Optional: GitHub Personal Access Token for persisting db.json updates to repo on Vercel
GITHUB_PAT=
